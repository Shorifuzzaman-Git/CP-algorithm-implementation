#include<bits/stdc++.h>
using namespace std;

const int N=1e3+10;
int n,m;
vector<int>g[N];
vector<int>vis(N);
vector<int>ans;

void dfs(int node){
    vis[node]=1;
    ans.push_back(node);

    for (auto child:g[node]){
        if(vis[child]==0){
            dfs(child);
        }
    }
    
}


int main(){
    cin>>n>>m;

    for(int i=0;i<m;i++){
        int u,v;
        cin>>u>>v;
        g[u].push_back(v);
        g[v].push_back(u);
    }

    dfs(1);
    for(auto i:ans){
        cout<<i<<' ';
    }
}
